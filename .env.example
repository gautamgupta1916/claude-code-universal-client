# CCUC configuration (all vars are prefixed CCUC_)

# --- server ---
CCUC_HOST=0.0.0.0
CCUC_PORT=8080
CCUC_LOG_LEVEL=INFO

# --- Claude CLI backend ---
CCUC_CLAUDE_BINARY=claude
# alias (opus|sonnet|haiku) or a full model id; sonnet is cheapest for dev
CCUC_DEFAULT_MODEL=sonnet
CCUC_NODE_HEAP_MB=8192
CCUC_INCLUDE_PARTIAL_MESSAGES=true

# --- storage (sessions + sqlite live under here) ---
CCUC_DATA_DIR=./.ccuc

# --- one-shot HTTP mode (POST /v1/agent/completions) ---
# Set false to serve the WebSocket gateway only.
CCUC_HTTP_MODE_ENABLED=true
# Much shorter than the WS turn timeout — a blocking HTTP call sits behind proxies.
CCUC_HTTP_TURN_TIMEOUT_S=300

# --- timeouts (seconds) ---
CCUC_TURN_TIMEOUT_S=1800
CCUC_IDLE_TTL_S=900

# --- seats (pool of OAuth subscription logins) ---
# JSON list of CLAUDE_CONFIG_DIR paths, each pre-authenticated via `claude auth login`.
# Leave empty to use ONE ambient seat that inherits the machine's default `claude` login
# (the right choice for local dev on macOS, where creds live in the Keychain).
CCUC_SEAT_DIRS=[]
CCUC_SEAT_MAX_CONCURRENCY=1

# --- auth ---
# Local dev shortcut key (set empty to require minted keys via `ccuc-keys`)
CCUC_DEV_API_KEY=devkey
# HMAC pepper for key hashing; leave empty to auto-persist one under CCUC_DATA_DIR
CCUC_KEY_PEPPER=

# --- Claude auth for containers (a Linux container has no ambient login) ---
# Generate on an already-logged-in machine:  claude setup-token
# then export it here (or in the shell running docker compose).
CLAUDE_CODE_OAUTH_TOKEN=
